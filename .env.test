PORT=3000

DB_NAME=mybitcoin
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Testes usam os serviços test-postgres-primary/replica do docker-compose
# (streaming replication, como a aplicação)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5444

DB_READ_HOST=localhost
DB_READ_PORT=5445

NODE_ENV=test

# API key estática do endpoint interno POST /financial/deposit/confirm
BLOCKCHAIN_MONITOR_API_KEY=test-blockchain-monitor-key
