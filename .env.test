PORT=3000

DB_NAME=mybitcoin
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Testes usam os serviços test-postgres-primary/replica do docker-compose
# (streaming replication, como a aplicação)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5444

DB_READ_HOST=localhost
DB_READ_PORT=5445

NODE_ENV=test

# KYC (ADR 0007) — valores fake válidos para testes
KYC_CPF_HASH_PEPPER=test-kyc-cpf-pepper-0123456789abcdef
KYC_CPF_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
