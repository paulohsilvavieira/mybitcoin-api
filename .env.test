PORT=3000

DB_NAME=mybitcoin
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Testes usam os serviços test-postgres-primary/replica do docker-compose
# (streaming replication, como a aplicação)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5444

DB_READ_HOST=localhost
DB_READ_PORT=5445

NODE_ENV=test

# Resend — envio de e-mail transacional (verificação de e-mail, ADR 0006)
RESEND_API_KEY=test_key_fake
EMAIL_FROM=noreply@test.mybitcoin.local
FRONTEND_ORIGIN=http://localhost:5173
