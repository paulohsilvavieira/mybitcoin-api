PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mybitcoin
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Write (primary) — se não definidas, cai no fallback DB_HOST/DB_PORT acima
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5432

# Read (réplica) — sem fallback, obrigatórias
DB_READ_HOST=localhost
DB_READ_PORT=5433

# Replicação (streaming replication postgres-primary → postgres-replica)
DB_REPLICATION_USER=replicator
DB_REPLICATION_PASSWORD=replicator_password
POSTGRES_REPLICA_PORT=5433


NODE_ENV=production

# gRPC — traces e metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317

# HTTP — logs (via Collector → Loki)
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://localhost:14318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic b3RlbDpvYnNlcnZhYmlsaXR5MTIz


OTEL_SERVICE_NAME=my-nestjs-app
PORT=3000
