PORT=3000

DB_NAME=mybitcoin
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Write (primary) — porta exposta no host pelo docker-compose
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5434

# Read (réplica) — obrigatórias
DB_READ_HOST=localhost
DB_READ_PORT=5435

NODE_ENV=development

# Recuperação de senha (ADR 0006) — base da URL do link enviado por email
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# gRPC — traces e metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317

# HTTP — logs (via Collector → Loki)
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://localhost:14318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic b3RlbDpvYnNlcnZhYmlsaXR5MTIz

OTEL_SERVICE_NAME=mybitcoin-api
